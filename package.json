{
  "name": "kaka-notification",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:web": "cd web && bun run dev",
    "build:web": "cd web && bun install && bun run build",
    "start": "bun run scripts/migrate.ts deploy && bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "create-admin": "bun run scripts/create-admin.ts",
    "cleanup": "bun run scripts/cleanup.ts",
    "load": "bun run scripts/load.ts",
    "test": "bun --env-file=.env.test test",
    "db:generate": "bunx prisma generate --schema=./prisma/schema",
    "db:dev": "bun run scripts/migrate.ts dev",
    "db:deploy": "bun run scripts/migrate.ts deploy"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@elysiajs/bearer": "1.3.0",
    "@elysiajs/swagger": "1.3.1",
    "@prisma/client": "6.5.0",
    "elysia": "1.3.9",
    "firebase-admin": "^13.5.0",
    "pino": "^9.7.0",
    "prisma": "6.5.0"
  }
}
