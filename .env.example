PORT=8080
DATABASE_PATH=./data/app.db
# openssl rand -base64 32  — encrypts service-account files. Losing it = re-uploading every credential.
MASTER_KEY=
# First admin, created on first boot only if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Set false only for local http development.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# Used to build absolute links in webhook payloads (e.g. https://notify.example.com)
PUBLIC_URL=
CHUNK_SIZE=200
MAX_TOKENS_PER_REQUEST=100000
MAX_BODY_SIZE=10mb
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
PROJECT_CONCURRENCY=2
WORKER_POLL_MS=1000
LEASE_SECONDS=300
SHUTDOWN_TIMEOUT_MS=30000
MAX_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=30,120,600,1800,3600
API_RATE_LIMIT_PER_MIN=60
# Admin login attempts per IP per minute (accounts also lock for 15 min after 5 failures)
LOGIN_RATE_LIMIT_PER_MIN=10
RESULT_RETENTION_DAYS=14
JOB_RETENTION_DAYS=30
# 0 = keep notifications forever
NOTIFICATION_RETENTION_DAYS=0
# Admin audit log; 0 = keep forever
AUDIT_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24
# firebase-admin transport. Keep true on Bun: its HTTP/2 client trips FCM's stream limit on normal batches.
FCM_HTTP1=true
# A send that takes longer is abandoned and retried (must be < LEASE_SECONDS)
SEND_TIMEOUT_MS=60000
LOG_LEVEL=info
